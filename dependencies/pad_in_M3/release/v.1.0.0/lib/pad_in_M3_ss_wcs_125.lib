/* pad_in_M3, coin ss_wcs_125 : modele de temps extrait par OpenSTA (write_timing_model)
 * depuis ref_pad_in_M3.sp (.subckt pad_in_M3) et les .lib de ses cellules :
 *   /Users/lionel/1BIT/OPENHW/IHP-Open-PDK/ihp-sg13cmos5l/libs.ref/sg13cmos5l_stdcell/lib/sg13cmos5l_stdcell_slow_1p08V_125C.lib
 *   /Users/lionel/1BIT/OPENHW/projets/nemisys_5l/sg13_extracells/cell/SRLATCH/char/results/srlatch_g5i2_abut_fromdb_slow.lib
 *   /Users/lionel/1BIT/OPENHW/projets/nemisys_5l/sg13_extracells/cell/SRBUF/char/results/srlatch_g5i2_in_fromdb_slow.lib
 * Ecrit par phys/outils/sta/etm_lib.tcl le 08/11/2026.
 * Hypothese : i_clk_p et i_clk_n a 200.0 MHz, 50 %, en opposition de phase ; transitions de 100.0 ps, charge de 5.0 fF.
 * Limites : setup / hold scalaires, retards fonction de la charge seule, sans parasites du dessin.
 */
library (pad_in_M3_ss_wcs_125) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1uA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 125.0;
  nom_voltage                    : 1.08;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
  }

  cell ("pad_in_M3") {
    area : 2000.000 
    is_macro_cell : true;
    pin("i_p2c") {
      direction : input;
      capacitance : 0.0047;
      timing() {
        related_pin : "i_clk_n";
        timing_type : hold_falling;
        rise_constraint(scalar) {
          values("-0.19595");
        }
        fall_constraint(scalar) {
          values("-0.15481");
        }
      }
      timing() {
        related_pin : "i_clk_n";
        timing_type : setup_falling;
        rise_constraint(scalar) {
          values("0.21244");
        }
        fall_constraint(scalar) {
          values("0.17120");
        }
      }
      timing() {
        related_pin : "i_clk_p";
        timing_type : hold_falling;
        rise_constraint(scalar) {
          values("-0.19595");
        }
        fall_constraint(scalar) {
          values("-0.15481");
        }
      }
      timing() {
        related_pin : "i_clk_p";
        timing_type : setup_falling;
        rise_constraint(scalar) {
          values("0.21244");
        }
        fall_constraint(scalar) {
          values("0.17120");
        }
      }
    }
    pin("i_clk_p") {
      direction : input;
      clock : true;
      capacitance : 0.0040;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.00000");
        }
        cell_fall(scalar) {
          values("0.00000");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.00000");
        }
        cell_fall(scalar) {
          values("0.00000");
        }
      }
    }
    pin("i_clk_n") {
      direction : input;
      clock : true;
      capacitance : 0.0060;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.00000");
        }
        cell_fall(scalar) {
          values("0.00000");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.00000");
        }
        cell_fall(scalar) {
          values("0.00000");
        }
      }
    }
    pin("o_raw_p") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "i_clk_n";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.32096,0.43909,0.50750,0.61987,0.80774,1.12035,1.64147");
        }
        rise_transition(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.03290,0.16554,0.26148,0.42152,0.69031,1.13770,1.88390");
        }
        cell_fall(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.34357,0.44726,0.50592,0.60207,0.76235,1.02908,1.47355");
        }
        fall_transition(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.02637,0.13634,0.21296,0.34127,0.55585,0.91447,1.51251");
        }
      }
    }
    pin("o_raw_n") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "i_clk_n";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.32096,0.43909,0.50750,0.61987,0.80774,1.12035,1.64147");
        }
        rise_transition(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.03290,0.16554,0.26148,0.42152,0.69031,1.13770,1.88390");
        }
        cell_fall(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.34357,0.44726,0.50592,0.60207,0.76235,1.02908,1.47355");
        }
        fall_transition(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.02637,0.13634,0.21296,0.34127,0.55585,0.91447,1.51251");
        }
      }
    }
  }

}
