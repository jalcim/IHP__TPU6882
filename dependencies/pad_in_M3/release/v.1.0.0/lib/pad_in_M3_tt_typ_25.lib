/* pad_in_M3, coin tt_typ_25 : modele de temps extrait par OpenSTA (write_timing_model)
 * depuis ref_pad_in_M3.sp (.subckt pad_in_M3) et les .lib de ses cellules :
 *   /Users/lionel/1BIT/OPENHW/IHP-Open-PDK/ihp-sg13cmos5l/libs.ref/sg13cmos5l_stdcell/lib/sg13cmos5l_stdcell_typ_1p20V_25C.lib
 *   /Users/lionel/1BIT/OPENHW/projets/nemisys_5l/sg13_extracells/cell/SRLATCH/char/results/srlatch_g5i2_abut_fromdb_typ.lib
 *   /Users/lionel/1BIT/OPENHW/projets/nemisys_5l/sg13_extracells/cell/SRBUF/char/results/srlatch_g5i2_in_fromdb_typ.lib
 * Ecrit par phys/outils/sta/etm_lib.tcl le 08/11/2026.
 * Hypothese : i_clk_p et i_clk_n a 200.0 MHz, 50 %, en opposition de phase ; transitions de 100.0 ps, charge de 5.0 fF.
 * Limites : setup / hold scalaires, retards fonction de la charge seule, sans parasites du dessin.
 */
library (pad_in_M3_tt_typ_25) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1uA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 1.20;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
  }

  cell ("pad_in_M3") {
    area : 2000.000 
    is_macro_cell : true;
    pin("i_p2c") {
      direction : input;
      capacitance : 0.0050;
      timing() {
        related_pin : "i_clk_n";
        timing_type : hold_falling;
        rise_constraint(scalar) {
          values("-0.14157");
        }
        fall_constraint(scalar) {
          values("-0.11353");
        }
      }
      timing() {
        related_pin : "i_clk_n";
        timing_type : setup_falling;
        rise_constraint(scalar) {
          values("0.14617");
        }
        fall_constraint(scalar) {
          values("0.11975");
        }
      }
      timing() {
        related_pin : "i_clk_p";
        timing_type : hold_falling;
        rise_constraint(scalar) {
          values("-0.14157");
        }
        fall_constraint(scalar) {
          values("-0.11353");
        }
      }
      timing() {
        related_pin : "i_clk_p";
        timing_type : setup_falling;
        rise_constraint(scalar) {
          values("0.14617");
        }
        fall_constraint(scalar) {
          values("0.11975");
        }
      }
    }
    pin("i_clk_p") {
      direction : input;
      clock : true;
      capacitance : 0.0042;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.00000");
        }
        cell_fall(scalar) {
          values("0.00000");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.00000");
        }
        cell_fall(scalar) {
          values("0.00000");
        }
      }
    }
    pin("i_clk_n") {
      direction : input;
      clock : true;
      capacitance : 0.0063;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.00000");
        }
        cell_fall(scalar) {
          values("0.00000");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.00000");
        }
        cell_fall(scalar) {
          values("0.00000");
        }
      }
    }
    pin("o_raw_p") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "i_clk_n";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.20261,0.27900,0.32287,0.39479,0.51496,0.71501,1.04833");
        }
        rise_transition(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.02146,0.10729,0.16934,0.27306,0.44751,0.73765,1.22175");
        }
        cell_fall(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.21811,0.28263,0.31809,0.37597,0.47242,0.63280,0.90004");
        }
        fall_transition(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.01731,0.08385,0.12999,0.20751,0.33790,0.55533,0.91856");
        }
      }
    }
    pin("o_raw_n") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "i_clk_n";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.20261,0.27900,0.32287,0.39479,0.51496,0.71501,1.04833");
        }
        rise_transition(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.02146,0.10729,0.16934,0.27306,0.44751,0.73765,1.22175");
        }
        cell_fall(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.21811,0.28263,0.31809,0.37597,0.47242,0.63280,0.90004");
        }
        fall_transition(template_1) {
          index_1("0.00100,  0.09360,  0.15600,  0.25920,  0.43200,  0.72000,  1.20000");
          values("0.01731,0.08385,0.12999,0.20751,0.33790,0.55533,0.91856");
        }
      }
    }
  }

}
