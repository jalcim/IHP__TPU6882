/* lvcmos_io_ff_bcs_m40 : bibliotheque de plots LVCMOS 1,2 V et 1,8 V (CMOS/LVCMOS_IO), corner ff_bcs_m40.
   Ecrit par lib/merge_lib.tcl le 2026-10-21 -- ne pas editer, relancer make lib.
   Plots signaux (lvcmos_IOPadIn12, lvcmos_IOPadOut12, lvcmos_IOPadIn18, lvcmos_IOPadOut18, lvcmos_IOPadIn18NH) : Liberty vernier (espece sngl_endedIO : tp, cin, op, netlist schematique
   avec diodes de plot et clamps, sans parasites de layout), cellules et broches renommees comme le dessin
   (IN/A -> PAD/C2P, VDDIO -> IOVDD, VSSIO -> IOVSS), aire de la lib factice (dessin).
   Rails : VDD 1.32 V, IOVDD12 1.32 V, IOVDD18 1.95 V (IOVDD : cadre, 1.95 V). Autres cellules : lib factice (sans timing). */

library (lvcmos_io_ff_bcs_m40){
  voltage_map (VDD, 1.32);
  voltage_map (VSS, 0);
  voltage_map (IOVDD, 1.95);
  voltage_map (IOVDD12, 1.32);
  voltage_map (IOVDD18, 1.95);
  voltage_map (IOVSS, 0);
  technology : cmos ;
  delay_model : table_lookup ;
  bus_naming_style : "%s[%d]" ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  leakage_power_unit : "1nW" ;
  current_unit : "1uA" ;
  pulling_resistance_unit : "1Ohm" ;
  capacitive_load_unit (1, pF);
  default_input_pin_cap : 0.001 ;
  default_inout_pin_cap : 0.001 ;
  default_output_pin_cap : 0 ;
  nom_process : 1.00 ;
  nom_voltage : 1.32 ;
  nom_temperature : -40 ;
  slew_upper_threshold_pct_rise : 90.00 ;
  slew_lower_threshold_pct_rise : 10.00 ;
  slew_upper_threshold_pct_fall : 90.00 ;
  slew_lower_threshold_pct_fall : 10.00 ;
  input_threshold_pct_rise : 50.00 ;
  input_threshold_pct_fall : 50.00 ;
  output_threshold_pct_rise : 50.00 ;
  output_threshold_pct_fall : 50.00 ;
  operating_conditions (typical) {
    process : 1.00 ;
    voltage : 1.32 ;
    temperature : -40 ;
  } /* end operating_conditions */
  lu_table_template (delay_template_3x3) {
    variable_1 : total_output_net_capacitance ;
    variable_2 : input_net_transition ;
    index_1 ("1.0, 2.0, 3.0");
    index_2 ("1.0, 2.0, 3.0");
  } /* end lu_table_template */
  cell (lvcmos_IOPadIn12) {
    area : 14400 ;
    pad_cell : true ;
    pin (PAD) {
      direction : input ;
      is_pad : true ;
      related_power_pin : IOVDD;
      related_ground_pin : IOVSS;
      fall_capacitance : 1.433613 ;
      fall_capacitance_range (1.43339, 1.43377);
      rise_capacitance : 1.433733 ;
      rise_capacitance_range (1.43314, 1.43419);
      capacitance : 1.433673 ;
    } /* end pin */
    pin (P2C) {
      direction : output ;
      related_power_pin : VDD;
      related_ground_pin : VSS;
      max_capacitance : 0.240000 ;
      function : PAD ;
      timing () {
        related_pin : PAD ;
        timing_sense : positive_unate ;
        timing_type : combinational ;
        cell_fall (delay_template_3x3) {
          index_1 ("0.024000, 0.096000, 0.240000") ;
          index_2 ("0.050000, 0.200000, 0.800000") ;
          values ( \
            "0.105203, 0.163605, 0.311911" \
